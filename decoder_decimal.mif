-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=8;
DEPTH=10;

ADDRESS_RADIX=UNS;
DATA_RADIX=BIN;

CONTENT BEGIN
    0 : 11000000; -- 0
    1 : 11111001; -- 1
    2 : 10100100; -- 2
    3 : 10110000; -- 3
    4 : 10011001; -- 4
    5 : 10010010; -- 5
    6 : 10000010; -- 6
    7 : 11111000; -- 7
    8 : 10000000; -- 8
    9 : 10010000; -- 9
END;
